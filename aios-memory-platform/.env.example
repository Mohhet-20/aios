DATABASE_URL=sqlite+aiosqlite:///./memory_platform.db
SECRET_KEY=change-me-in-production-32-characters-minimum
APP_ENV=development

# Memory lifecycle defaults
DEFAULT_MEMORY_RETENTION_DAYS=365
DEFAULT_IMPORTANCE_DECAY_RATE=0.02
WORKING_MEMORY_TTL_SECONDS=1800
SUMMARIZATION_TRIGGER_TOKEN_COUNT=4000

# Retrieval defaults
DEFAULT_TOP_K=10
HYBRID_SEARCH_SEMANTIC_WEIGHT=0.7
CONTEXT_TOKEN_BUDGET=8000

# Governance
RETENTION_ENFORCEMENT_ENABLED=true
