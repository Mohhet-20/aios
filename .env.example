# Copy to .env (git-ignored) before `docker compose up`. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Service-to-service token: the console edge sends it, every service requires it (min 32 chars).
AIOS_INTERNAL_TOKEN=
# Identity service signing key (its SECRET_KEY); the console verifies session tokens with it (min 32 chars).
AIOS_JWT_SECRET=

# Optional public demo account, shown on the sign-in page. Create it with scripts/seed_demo.py.
AIOS_DEMO_EMAIL=
AIOS_DEMO_PASSWORD=
