DATABASE_URL=sqlite+aiosqlite:///./workflow_platform.db
SECRET_KEY=dev-secret-key-change-me-in-production-32chars
APP_ENV=development
DEFAULT_NODE_TIMEOUT_SECONDS=300
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_BACKOFF_SECONDS=2.0
MAX_WORKFLOW_RECURSION_DEPTH=10
MAX_PARALLEL_BRANCHES=20
SCHEDULER_POLL_INTERVAL_SECONDS=5
DEFAULT_APPROVAL_ESCALATION_HOURS=24
WORKSPACE_MAX_CONCURRENT_EXECUTIONS=50
